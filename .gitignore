# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environment ────────────────────────────────
venv/
.venv/
env/

# ── Flask Instance (DB + local config) ─────────────────
instance/

# ── Environment Variables (secrets) ────────────────────
.env

# ── IDE / Editor ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Files ───────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Audio Cache ────────────────────────────────────────
app/static/audio/*.mp3
app/static/audio/*.wav

# ── Migrations (keep, but ignore __pycache__) ──────────
migrations/__pycache__/
